# 복사해서 .env로 쓴다 (.env는 커밋 금지). 값 형식은 init_chat_model의 "provider:model".
# "fake"면 GenericFakeChatModel / fake 임베딩을 쓴다 (테스트·MOCK 개발용, 네트워크 없음).

# router 등 가벼운 호출 (design §2 모델 분리)
FAST_MODEL=ollama:qwen3:0.6b
# Coach·Reviewer 등 품질이 중요한 호출. 최종 확인·측정은 openai:gpt-4o-mini
QUALITY_MODEL=ollama:qwen3.5:4b
# RAG 임베딩 (MCP 서버 프로세스 안에서 사용)
EMBEDDING_MODEL=ollama:nomic-embed-text

# 사용자 데이터 폴더 (profile.json, docs/, job_posting.md, coach.db, checkpoints.db, 임베딩 캐시)
# 기본값 ./data. 시연용 데이터는 `bash sh/seed_sample.sh`로 examples/sample_user를 복사
COACH_DATA_DIR=./data

# OpenAI를 쓸 때만
OPENAI_API_KEY=
# ollama 서버 주소 (기본값이면 비워 둠)
OLLAMA_BASE_URL=

# LangSmith trace (design §3)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
